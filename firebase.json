{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": false
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "CLAUDE.md",
      "README.md",
      "LICENSE",
      "firestore.rules",
      "firestore.indexes.json",
      "skills-lock.json",
      "docs/**",
      "ref/**",
      "render/**",
      "scripts/**",
      "source/**",
      "tests/**",
      "media/img/**"
    ]
  }
}
