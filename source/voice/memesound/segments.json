      "gainDb": -13.3,
      "outputGainDb": 2.94
    },
    {
      "id": "m5-5",
      "text": "감겼어욕!",
      "start": 93.388798,
      "end": 97.83932,
      "sourceLufs": -14.5,
      "sourceTruePeakDbfs": -4.2,
      "gainDb": -12.1,
