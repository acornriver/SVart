      "gainDb": -9.7,
      "outputGainDb": 2.99
    },
    {
      "id": "m7-2",
      "text": "높은 음이 들린 쪽으로 화면 속 저를 밀어주세요.",
      "start": 120.297324,
      "end": 123.621134,
      "sourceLufs": -16.2,
      "sourceTruePeakDbfs": -4.6,
      "gainDb": -10.6,
      "outputGainDb": 3.12
    },
    {
      "id": "m7-3",
      "text": "자, 세 번 가볼게요!",
