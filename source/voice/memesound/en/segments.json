  "segments": [
    {
      "id": "m1-1",
      "text": "Hey, everyone! I can grow and shrink! Swipe your finger up and down on the screen.",
      "start": 0,
      "end": 4.945182,
      "sourceLufs": -13.8,
      "sourceTruePeakDbfs": -0.7,
      "gainDb": -12.8,
      "outputGainDb": 3.66
    },
    {
      "id": "m1-2",
      "text": "Oh! When I get bigger, the sound gets louder. When I get smaller, it gets quieter. Can you hear it change?",
      "start": 4.945182,
      "end": 11.012358,
      "sourceLufs": -15.5,
      "sourceTruePeakDbfs": -1.0,
      "gainDb": -11.1,
      "outputGainDb": 3.09
    },
    {
      "id": "m1-3",
      "text": "When the volume feels comfortable, press and hold me on the screen.",
      "start": 11.243311,
      "end": 14.754218,
      "sourceLufs": -16.5,
      "sourceTruePeakDbfs": -1.0,
      "gainDb": -10.1,
      "outputGainDb": 3.49
    },
    {
      "id": "m2-1",
      "text": "Now it’s my tail’s turn! Swipe up and down on the screen and listen to how the sound changes.",
      "start": 14.855986,
      "end": 20.308231,
      "sourceLufs": -16.8,
      "sourceTruePeakDbfs": -0.8,
      "gainDb": -9.8,
      "outputGainDb": 3.6
    },
    {
      "id": "m2-2",
      "text": "When you find the sound that feels most comfortable, press and hold me on the screen!",
      "start": 20.471066,
      "end": 24.974308,
      "sourceLufs": -17.9,
      "sourceTruePeakDbfs": -1.2,
      "gainDb": -8.7,
      "outputGainDb": 3.31
    },
    {
      "id": "m3-1",
      "text": "Oh, and this time, my head can get longer or shorter too! Just like before, swipe up and down and listen to how the sound changes.",
      "start": 25.174082,
      "end": 32.282404,
      "sourceLufs": -16.3,
      "sourceTruePeakDbfs": -1.5,
      "gainDb": -10.3,
