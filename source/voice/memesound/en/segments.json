      "gainDb": -10.8,
      "outputGainDb": 2.82
    },
    {
      "id": "m4-1",
      "text": "Hey, everyone!!! I’ve got a melody for you!!! I’ll play the same tune three times, with a different sound each time.",
      "start": 38.969615,
