      "sourceTruePeakDbfs": -1.1,
      "gainDb": -10.8,
      "outputGainDb": 3.56
    },
    {
      "id": "m4-4",
      "text": "Listen to all three sounds, one at a time. Choose the spot for the sound that feels most comfortable. Then press and hold me on the screen.",
