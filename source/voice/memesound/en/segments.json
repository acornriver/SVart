          "gainDb": -10.2
        }
      ],
      "update": "2026-11-12: latest f/w/a recording; original gesture/count instructions retained.",
      "outputGainDb": 3.08
    },
    {
      "id": "m4-2",
      "text": "As each sound plays, a spot will be marked on the screen. Watch for it!",
      "start": 45.6439,
      "end": 50.170431,
      "sourceLufs": -14.5,
      "sourceTruePeakDbfs": -1.2,
      "gainDb": -12.1,
      "outputGainDb": 2.74
    },
    {
      "id": "m4-3",
      "text": "Want to hear one of those sounds again? Tap its spot on the screen.",
